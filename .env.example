# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# LiveKit: server-side only. NEVER expose these to the React frontend.
# Used by /api/livekit/token (server/tokenServer.ts) to mint participant tokens.
# Leave unset to run Live Meetings in Demo Mode (simulated participants + transcript).
LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY="MY_LIVEKIT_API_KEY"
LIVEKIT_API_SECRET="MY_LIVEKIT_API_SECRET"

# ---------------------------------------------------------------------------
# Cloud meeting recording (LiveKit Egress → MP4 → S3-compatible storage).
# ALL of these are server-side only — never prefixed with VITE_, never sent
# to the browser. Leave unset to run meetings without cloud recording.
#
# Works with any S3-compatible provider. Cloudflare R2 example:
#   RECORDING_STORAGE_PROVIDER=s3
#   RECORDING_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   RECORDING_S3_REGION=auto
#   RECORDING_S3_BUCKET=meetflow-recordings
#   RECORDING_S3_ACCESS_KEY=<r2 access key id>
#   RECORDING_S3_SECRET_KEY=<r2 secret access key>
#   RECORDING_S3_PUBLIC_URL_BASE=https://<public-bucket-or-custom-domain>
#
# AWS S3 example:
#   RECORDING_STORAGE_PROVIDER=s3
#   RECORDING_S3_ENDPOINT=            (empty — LiveKit uses the AWS default)
#   RECORDING_S3_REGION=us-east-1
#   RECORDING_S3_BUCKET=meetflow-recordings
#   RECORDING_S3_ACCESS_KEY=<aws access key id>
#   RECORDING_S3_SECRET_KEY=<aws secret access key>
#   RECORDING_S3_PUBLIC_URL_BASE=https://meetflow-recordings.s3.amazonaws.com
# ---------------------------------------------------------------------------
RECORDING_STORAGE_PROVIDER="s3"
RECORDING_S3_ENDPOINT=""
RECORDING_S3_REGION="auto"
RECORDING_S3_BUCKET=""
RECORDING_S3_ACCESS_KEY=""
RECORDING_S3_SECRET_KEY=""
# Optional: path-style addressing (auto-enabled for R2 endpoints).
RECORDING_S3_FORCE_PATH_STYLE=""
# Optional: public https base used to build playback/download URLs
# (public bucket, r2.dev public link, or a custom domain). If unset, the
# S3 endpoint/bucket path-style URL is used.
RECORDING_S3_PUBLIC_URL_BASE=""
# Room composite recording layout (speaker = active speaker large + thumbnails).
RECORDING_LAYOUT="speaker"
